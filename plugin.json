{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "jt-harness-plugin",
  "version": "1.44.2",
  "description": "JurisLM's automatically invoked engineering rules for Codex.",
  "author": {
    "name": "Terry Chen",
    "url": "https://github.com/jurislm"
  },
  "homepage": "https://github.com/jurislm/jt-harness-plugin",
  "repository": "https://github.com/jurislm/jt-harness-plugin",
  "license": "UNLICENSED",
  "keywords": [
    "guidance",
    "linear",
    "superpowers",
    "code-review",
    "coolify",
    "hetzner",
    "delivery-rules"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "JT Harness Plugin",
        "shortDescription": "Automatic engineering delivery rules.",
        "longDescription": "Automatically supplies Linear tracking, platform plugin routing, one-pass review, and merge rules for engineering work.",
        "developerName": "JurisLM",
        "category": "Developer tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Use using-jt-harness for this engineering task."
        ],
        "websiteURL": "https://github.com/jurislm/jt-harness-plugin"
      }
    }
  }
}
